# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
# Launcher 元数据快照（scripts/build-launcher-metadata.mjs 生成，由 build-api 镜像进 dist）
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Vite cache
.vite/
*.local

# Wrangler
.wrangler/
.wrangler-dry/
.dev.vars

# Temp / scratch
.tmp-*

# 数据脚本的远程表缓存（Material.json 等，可重新下载）
scripts/.cache/

# 敌人一图流大图（每张 2~5 MB，站点构建用，不入库）
public/images/enemies/*/reference*.png
