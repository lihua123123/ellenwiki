{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ellenwiki",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-21",
	// ⚠️ 开关必须写在配置里：Cloudflare Workers Builds 在 push 后自动构建时不带 `--var`，
	// 缺省 false 会让构建产物把 /api/launcher/* 落回空的 worker-static（build/launcher/ 未入库）→ 404。
	// 显式关闭（回滚）：`wrangler deploy --var R2_JSON_ENABLED:false --var R2_VERSIONED_ENABLED:false`。
	"vars": {
		"R2_JSON_ENABLED": "true",
		"R2_VERSIONED_ENABLED": "true",
		"R2_ASSETS_ENABLED": "true"
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// ⚠️ 必须是 `/api/*` 而不是只列 assets 子路径：一旦用了数组形式，**未匹配的路径
		// 不会再进 Worker**（会被静态层的 SPA 兜底成 index.html，导致整个数据 API 变成 HTML）。
		// 覆盖 /api/* 同时兼顾图标回源与原有 JSON 转发；站点静态文件仍走快速路径。
		// `/api` 本身要单独列：`/api/*` 的通配不匹配无尾斜杠的根路径。
		"run_worker_first": [
			"/api",
			"/api/*",
			// 图片必须进 Worker：否则静态层会直接返回 dist 镜像（无 X-Ellen-Asset、Cache-Control
			// 是资产默认值），dist 缺失时还会被 SPA 兜底成 index.html（<img> 拿到 HTML）。
			// 进 Worker 后走 serveImage：R2 版本化优先 -> dist 镜像 -> JSON 404。
			"/images/*"
		]
	},
	"r2_buckets": [
		{
			"bucket_name": "ellen-assets",
			"binding": "ellen_assets",
			"remote": true
		}
	]
}