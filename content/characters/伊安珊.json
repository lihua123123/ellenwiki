  "passives": [
    {
      "name": "强化抗阻练习",
      "description": "「雷霆飞缒」命中敌人后，伊安珊将获得「标准动作」效果，持续15秒。\n持续期间，伊安珊的攻击力提升20%，通过元素爆发力的三原理中的动能标示恢复夜魂值时，还会额外恢复1点夜魂值；此外，队伍中自己的当前场上角色消耗或恢复夜魂值后，伊安珊下一次通过动能标示恢复夜魂值时，额外恢复的夜魂值提升至4点，该效果每2.8秒至多触发一次。\n「标准动作」效果将在伊安珊的夜魂加持结束时消失。",
      "lore": "",
      "states": [],
      "category": "ascension"
    },
    {
      "name": "动能梯度测验",
      "description": "队伍中的附近的角色触发「夜魂迸发」时，伊安珊将获得「热身效应」，持续10秒。\n持续期间，伊安珊恢复至少1点夜魂值时，会为当前场上自己的角色恢复生命值，回复量相当于伊安珊攻击力的60%，该效果每2.8秒至多触发一次。",
      "lore": "",
      "states": [],
      "category": "ascension"
    },
    {
      "name": "夜域赐礼·勉力传动",
      "description": "在夜魂值耗竭后，伊安珊在场上时，将会转而消耗燃素来维持夜魂加持。\n在纳塔存在燃素机制的区域时，能够进行夜魂传递·伊安珊。当前场上角色处于冲刺或是特定天赋赋予的移动状态下时，或是位于一定高度的空中时，切换伊安珊登场时触发：伊安珊将进入夜魂加持状态，并获得25点夜魂值。自己的队伍每10秒可以触发一次夜魂传递。\n此外，在纳塔存在燃素机制的区域时，伊安珊利用地形差进行飞跃时，不会承受坠落伤害。",
      "lore": "",
      "states": [],
      "category": "utility"
    },
    {
      "name": "热量均衡计划",
      "description": "在纳塔存在燃素机制的区域时，当燃素从50%以上降低至50%以下时能恢复10点燃素，该效果每10秒至多触发一次。",
      "lore": "",
      "states": [],
      "category": "utility"
    }
  ],
