  "passives": [
    {
      "name": "古海孑遗的权柄",
      "description": "队伍中的角色对敌人触发蒸发、冻结、感电、月感电、绽放、月绽放、水元素扩散、水元素结晶或月结晶反应时，将为那维莱特产生持续30秒，至多叠加3层的「遗龙之荣」效果，使重击·衡平推裁造成原本110%/125%/160%的伤害。\n每种元素反应产生的「遗龙之荣」分别独立存在。",
      "lore": "",
      "states": [],
      "category": "ascension"
    },
    {
      "name": "至高仲裁的纪律",
      "description": "基于当前生命值超出生命值上限30%的部分，每1%使那维莱特获得0.6%水元素伤害加成，通过这种方式，至多提升30%。",
      "lore": "",
      "states": [],
      "category": "ascension"
    },
    {
      "name": "汇聚如浪潮一般",
      "description": "队伍中自己的角色进行水下冲刺时，移动速度提升15%。\n无法与效果完全相同的固有天赋叠加。",
      "lore": "",
      "states": [],
      "category": "utility"
    }
  ],
