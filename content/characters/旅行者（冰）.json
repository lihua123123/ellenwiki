  "passives": [
    {
      "name": "自锐的凛冰",
      "description": "辉映·星超导：栗烈寒星存在期间，旅行者的普通攻击、重击、下落攻击将转为造成无法被附魔覆盖的冰元素伤害，且造成的伤害提升，提升值相当于旅行者攻击力的80%。",
      "lore": "",
      "states": [],
