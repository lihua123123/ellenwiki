{
  "name": "wiki-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "艾莲的数据库 · 整合版：伤害计算公式 / 幽境Boss图鉴 / 产球及附着，统一 UI 框架",
  "scripts": {
    "dev": "npm run parse && vite",
    "build": "npm run parse && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "data": "node scripts/data.mjs",
    "esdata": "node scripts/esdata.mjs",
    "api": "wrangler dev --port 8787",
    "parse": "node scripts/parse-boss.mjs && node scripts/parse-attachment.mjs",
    "index": "node scripts/generate-weapons.mjs && node scripts/generate-artifacts.mjs && node scripts/generate-game-ids.mjs",
    "refresh": "node scripts/generate-profiles.mjs && node scripts/generate-weapons.mjs --force && node scripts/generate-artifacts.mjs --force && npm run parse && node scripts/sync-character-versions.mjs && node scripts/sync-buffs.mjs",
    "refresh:characters": "node scripts/generate-profiles.mjs",
    "refresh:equip": "node scripts/generate-weapons.mjs --force && node scripts/generate-artifacts.mjs --force",
    "buffs": "node scripts/sync-buffs.mjs",
    "game-ids": "node scripts/generate-game-ids.mjs",
    "versions": "node scripts/sync-character-versions.mjs",
    "icons": "node scripts/generate-weapons.mjs --icons && node scripts/generate-artifacts.mjs --icons",
    "avatars": "node scripts/fetch-avatars2.mjs",
    "snap": "node scripts/import-snap.mjs"
  },
  "devDependencies": {
    "vite": "^8.1.4",
    "wrangler": "^4.136.1"
  },
  "dependencies": {
    "genshin-db": "^5.2.13",
    "katex": "^0.16.11",
    "marked": "^14.0.0"
  }
}
